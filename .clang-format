# Objective-C style for every project in this repository (`make format` / `make lint`).
# Same style as the c and cpp repositories, so C, C++, and Objective-C format identically.
# Pinned clang-format release line: 19 (Debian trixie in the container, PyPI wheels natively).
BasedOnStyle: Google
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Preserve
