# Shared ignores (identical base in every Dialectic Playground repository).
# Python tooling (scripts, test runners, docs builds)
__pycache__/
*.py[cod]
.venv/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Repository-specific: Objective-C build output of every project, including GNUstep's
# dependency (.d) files (make clean removes it).
build/
*.d
*.o
*.exe
